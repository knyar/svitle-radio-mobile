{
  "name": "svitle-radio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "run-svitle-ios": "react-native run-ios --scheme SvitleRadio --mode Svitle.Debug",
    "run-svitle-android": "react-native run-android --mode svitleDebug --appId com.svitleradio",
    "run-svetloe-android": "react-native run-android --mode svetloeDebug --appId org.svetloe",
    "release-svitle-android": "cd android && ./gradlew bundleSvitleRelease",
    "release-svetloe-android": "cd android && ./gradlew bundleSvetloeRelease",
    "build-svitle-android": "cd android && ./gradlew assembleSvitleRelease",
    "start": "react-native start",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint index.js player-service.js app test __mocks__ scripts --ext .js,.ts,.tsx --max-warnings 0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint index.js player-service.js app test __mocks__ scripts --ext .js,.ts,.tsx --fix --no-error-on-unmatched-pattern",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=50%",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn test:ci",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.8",
    "@react-navigation/native": "^7.1.14",
    "@sentry/react-native": "^7.7.0",
    "apisauce": "3.0.1",
    "i18n-js": "^3.0.11",
    "mobx": "^4.15.4",
    "mobx-react-lite": "^2.0",
    "mobx-state-tree": "^3.14.1",
    "react": "19.1.0",
    "react-native": "^0.81.0",
    "react-native-build-config": "^0.3.2",
    "react-native-device-info": "^10.9.0",
    "react-native-localize": "^3.0.2",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.0",
    "react-native-track-player": "^4.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "^0.81.0",
    "@react-native/typescript-config": "0.81.5",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.2.1",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.2",
    "test-renderer": "~1.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "yarn@1.22.22"
}
