# Disable New Architecture
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

project 'SvitleRadio',
        'Svitle.Debug' => :debug,
        'Svitle.Release' => :release

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SvitleRadio' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 refuses deployment targets below iOS 15 as a hard error. React Native's
    # post_install raises the native library targets to min_ios_version_supported but skips
    # resource-bundle targets (RNSVG-RNSVGFilters, RNCAsyncStorage_resources, ...), which keep
    # the floors from their podspecs. Fixed upstream in react-native#58687 (not in 0.81).
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end

    # Apple clang 21 (Xcode 26.4 and later) rejects fmt 11's consteval format strings with
    # "call to consteval function ... is not a constant expression". React Native 0.83.5+ moved
    # to fmt 12.1.0 (react-native#55601); 0.81 still pins 11.0.2, so turn consteval off in the
    # header every pod includes. Idempotent: pod install reruns this on the cached Pods tree.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      marker = '// Podfile: consteval off for Apple clang 21'
      source = File.read(fmt_base)
      unless source.include?(marker)
        anchor = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        raise "fmt/base.h changed; update the consteval workaround in the Podfile" unless source.include?(anchor)
        source = source.sub(anchor, "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0 #{marker}\n#{anchor}")
        File.write(fmt_base, source)
        Pod::UI.puts 'fmt: consteval disabled in fmt/base.h for Apple clang 21'.green
      end
    end
  end
end
