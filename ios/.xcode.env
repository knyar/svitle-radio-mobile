# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export PATH=$PATH:/opt/homebrew/bin
export NODE_BINARY=$(command -v node)

export SENTRY_PROPERTIES=sentry.properties

# Fresh clones and CI have no Sentry credentials. Skip source-map and dSYM
# uploads in that case instead of failing the "Bundle React Native code and
# images" phase. Both Sentry script phases honour this variable.
# To upload, create ios/sentry.properties from sentry.properties.tpl, or export
# SENTRY_AUTH_TOKEN before building. Note that .xcode.env.local is sourced
# after this file, so a token set there must be paired with
# "export SENTRY_DISABLE_AUTO_UPLOAD=false".
if [ -z "$SENTRY_AUTH_TOKEN" ] && [ ! -f "$SENTRY_PROPERTIES" ]; then
  export SENTRY_DISABLE_AUTO_UPLOAD=true
fi
