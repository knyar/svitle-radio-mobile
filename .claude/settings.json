{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-post-edit.sh",
            "timeout": 120,
            "statusMessage": "yarn typecheck && yarn lint"
          }
        ]
      }
    ]
  }
}
